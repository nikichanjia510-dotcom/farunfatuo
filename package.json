{
  "name": "tuobao-legal-care",
  "version": "1.0.0",
  "private": true,
  "description": "“法润托育·智护成长”托宝法治早教答辩展示产品",
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @tuobao/api --filter @tuobao/web dev",
    "lint": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "build:static": "pnpm --filter @tuobao/web build:static",
    "build:site": "pnpm --filter @tuobao/web build:site",
    "db:generate": "drizzle-kit generate",
    "e2e": "playwright test",
    "check": "pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "drizzle-kit": "0.31.10"
  }
}
